# ─────────────────────────────────────────────────────────────────────────────
# editing-workspace — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: ElevenLabs Scribe — word-level transcription for video-use
# Get one at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# OPTIONAL: OpenAI — used by the caption/description generator for style matching
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL: Anthropic — alternative LLM for caption generation
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Image Generation ──────────────────────────────────────────────────────────
# Google Gemini (Imagen 3)
GEMINI_API_KEY=

# Image generation configuration
IMAGE_GENERATOR_BACKEND=auto  # "openai" | "gemini" | "auto"
IMAGE_DEFAULT_QUALITY=standard  # "standard" | "hd" (openai dall-e-3 only)

# OPTIONAL: Preferred LLM backend for caption module ("openai" | "anthropic")
# Defaults to "openai" if OPENAI_API_KEY is set, else "anthropic".
CAPTION_LLM_BACKEND=openai
